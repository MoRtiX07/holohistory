/* ==========================================================================
   Holo Persona — Stylesheet (v2.6)
   Modern Cybernetic Museum Interface — Clean, Responsive & Fast
   ========================================================================== */

:root {
  /* Default: Einstein (Electric Cyan) */
  --primary-accent: #00f0ff;
  --accent-glow: rgba(0, 240, 255, 0.4);
  --accent-glow-subtle: rgba(0, 240, 255, 0.12);
  --accent-secondary: #3b82f6;
  --bg-base: #07090e;
  --bg-surface-1: rgba(12, 16, 28, 0.85);
  --bg-surface-2: rgba(18, 24, 42, 0.92);
  --bg-surface-border: rgba(0, 240, 255, 0.2);
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --text-dim: #64748b;
  --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-heading: 'Space Grotesk', 'Plus Jakarta Sans', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --border-radius-lg: 14px;
  --border-radius-md: 9px;
  --border-radius-sm: 6px;
  --shadow-elevated: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
  --transition-fast: 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-smooth: 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Kalam Theme (Solar Gold) */
body[data-theme="kalam"] {
  --primary-accent: #fbbf24;
  --accent-glow: rgba(251, 191, 36, 0.4);
  --accent-glow-subtle: rgba(251, 191, 36, 0.12);
  --accent-secondary: #f97316;
  --bg-base: #090704;
  --bg-surface-1: rgba(24, 18, 10, 0.85);
  --bg-surface-2: rgba(36, 26, 14, 0.92);
  --bg-surface-border: rgba(251, 191, 36, 0.22);
}

/* Tesla Theme (Plasma Violet) */
body[data-theme="tesla"] {
  --primary-accent: #c084fc;
  --accent-glow: rgba(192, 132, 252, 0.4);
  --accent-glow-subtle: rgba(192, 132, 252, 0.12);
  --accent-secondary: #8b5cf6;
  --bg-base: #080510;
  --bg-surface-1: rgba(18, 13, 32, 0.85);
  --bg-surface-2: rgba(28, 20, 50, 0.92);
  --bg-surface-border: rgba(192, 132, 252, 0.22);
}

/* Reset & Sizing */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  width: 100%;
  font-family: var(--font-main);
  background-color: var(--bg-base);
  color: var(--text-main);
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Subtle Ambient Background */
.ambient-glow-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 0;
  background: 
    radial-gradient(circle at 10% 15%, var(--accent-glow-subtle) 0%, transparent 40%),
    radial-gradient(circle at 90% 85%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
}

.subtle-grid-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 1;
  background-image: 
    linear-gradient(to right, rgba(255, 255, 255, 0.015) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
  background-size: 32px 32px;
}

/* App Header */
.app-header {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60px;
  padding: 0 1.5rem;
  background: var(--bg-surface-1);
  border-bottom: 1px solid var(--bg-surface-border);
  backdrop-filter: blur(16px);
  gap: 1rem;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.logo-mark {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--accent-secondary), var(--primary-accent));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: 0 0 14px var(--accent-glow);
}

.brand-title {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: 1.2px;
  color: #ffffff;
  line-height: 1.1;
  display: block;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 2px;
}

.sub-badge {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.8px;
  color: var(--primary-accent);
  background: var(--accent-glow-subtle);
  padding: 1px 5px;
  border-radius: 3px;
  border: 1px solid var(--accent-glow);
}

.live-status {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: #4ade80;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-weight: 600;
}

.pulse-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #4ade80;
  box-shadow: 0 0 6px #4ade80;
  animation: pulse-ring 1.6s infinite ease-in-out;
}

/* Persona Navigation Tabs */
.persona-nav {
  display: flex;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24px;
  padding: 3px;
  gap: 3px;
}

.persona-tab-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.95rem;
  background: transparent;
  border: none;
  border-radius: 20px;
  color: var(--text-muted);
  font-family: var(--font-main);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.persona-tab-btn:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.06);
}

.persona-tab-btn.active {
  background: var(--primary-accent);
  color: #060913;
  font-weight: 700;
  box-shadow: 0 0 12px var(--accent-glow);
}

.tab-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.7;
}

/* Single Persona Locked Banner */
.kiosk-locked-banner {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  background: rgba(0, 0, 0, 0.5);
  border: 1px solid var(--primary-accent);
  box-shadow: 0 0 14px var(--accent-glow-subtle);
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-family: var(--font-mono);
}

.kiosk-indicator {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--primary-accent);
  box-shadow: 0 0 8px var(--primary-accent);
}

.kiosk-text {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 1px;
  color: #ffffff;
}

.kiosk-tag {
  font-size: 0.62rem;
  font-weight: 700;
  background: var(--primary-accent);
  color: #060913;
  padding: 1px 6px;
  border-radius: 10px;
}

/* Header Controls */
.header-right {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.speed-selector {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--border-radius-sm);
  padding: 2px 4px;
  gap: 2px;
}

.selector-tag {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--text-dim);
  padding: 0 3px;
}

.speed-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  padding: 3px 6px;
  border-radius: 3px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.speed-btn:hover {
  color: #fff;
}

.speed-btn.active {
  background: var(--primary-accent);
  color: #060913;
  font-weight: 700;
}

.header-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.09);
  color: var(--text-main);
  font-family: var(--font-mono);
  font-size: 0.74rem;
  padding: 0.4rem 0.75rem;
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.header-action-btn:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: var(--primary-accent);
  color: #ffffff;
}

.header-action-btn.icon-only {
  padding: 0.4rem 0.55rem;
}

.btn-svg {
  flex-shrink: 0;
}

.qr-action-btn {
  border-color: rgba(192, 132, 252, 0.3);
  color: #c084fc;
}

.qr-action-btn:hover {
  border-color: #c084fc;
  box-shadow: 0 0 10px rgba(192, 132, 252, 0.3);
}

.memory-action-btn {
  border-color: var(--accent-glow);
  color: var(--primary-accent);
}

.count-pill {
  background: var(--primary-accent);
  color: #060913;
  font-weight: 700;
  font-size: 0.62rem;
  padding: 1px 5px;
  border-radius: 8px;
}

.surprise-action-btn {
  border-color: rgba(251, 191, 36, 0.4);
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.08);
}

.surprise-action-btn:hover {
  border-color: #fbbf24;
  color: #ffffff;
  background: rgba(251, 191, 36, 0.2);
  box-shadow: 0 0 14px rgba(251, 191, 36, 0.45);
  transform: translateY(-1px);
}

.codex-action-btn {
  border-color: rgba(59, 130, 246, 0.4);
  color: #60a5fa;
  background: rgba(59, 130, 246, 0.08);
}

.codex-action-btn:hover {
  border-color: #60a5fa;
  color: #ffffff;
  background: rgba(59, 130, 246, 0.2);
  box-shadow: 0 0 14px rgba(59, 130, 246, 0.45);
  transform: translateY(-1px);
}

/* ==========================================================================
   Main Grid Layout (Perfect Fit for PC Displays)
   ========================================================================== */
.main-layout {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: 460px 1fr;
  height: calc(100vh - 60px);
  gap: 1.15rem;
  padding: 1rem 1.5rem;
  max-width: 1760px;
  margin: 0 auto;
}

/* Left: Hologram Stage Panel */
.hologram-stage {
  height: 100%;
  min-height: 0;
}

.stage-card {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-surface-1);
  border: 1px solid var(--bg-surface-border);
  border-radius: var(--border-radius-lg);
  backdrop-filter: blur(20px);
  box-shadow: var(--shadow-elevated);
  padding: 1.15rem;
  position: relative;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
}

.stage-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.55rem;
  flex-shrink: 0;
}

.feed-status {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.feed-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--primary-accent);
  box-shadow: 0 0 8px var(--primary-accent);
  animation: pulse-ring 2s infinite ease-in-out;
}

.feed-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 600;
  color: var(--primary-accent);
  letter-spacing: 0.8px;
}

.era-badge {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.05);
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
}

/* Projection Emitter & Grand Hologram Stage */
.emitter-view {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  min-height: 440px;
  height: 450px;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: var(--border-radius-md);
  background: radial-gradient(circle at 50% 35%, rgba(12, 18, 36, 0.95) 0%, rgba(4, 7, 16, 0.98) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 0 45px rgba(0, 0, 0, 0.85), 0 10px 30px rgba(0, 0, 0, 0.5);
  margin-bottom: 0.85rem;
}

/* Floating Artifacts Layer & Floating Invention Cards */
.floating-artifacts-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 9;
}

.floating-artifact-card {
  position: absolute;
  pointer-events: auto;
  width: 92px;
  background: rgba(8, 12, 24, 0.9);
  border: 1px solid var(--bg-surface-border);
  border-radius: var(--border-radius-sm);
  backdrop-filter: blur(12px);
  padding: 4px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.65), 0 0 10px var(--accent-glow-subtle);
  cursor: pointer;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
}

.floating-artifact-card.pos-left {
  left: 6px;
  top: 52px;
  animation: floatDriftLeft 7s ease-in-out infinite alternate;
}

.floating-artifact-card.pos-right {
  right: 6px;
  top: 52px;
  animation: floatDriftRight 8s ease-in-out infinite alternate;
}

.floating-artifact-card:hover {
  transform: translateY(-3px) scale(1.08);
  border-color: var(--primary-accent);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8), 0 0 18px var(--accent-glow);
  z-index: 11;
}

.floating-card-thumb {
  position: relative;
  width: 100%;
  height: 52px;
  border-radius: 4px;
  overflow: hidden;
  background: #050811;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.floating-card-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.floating-artifact-card:hover .floating-card-thumb img {
  transform: scale(1.08);
}

.floating-card-badge {
  position: absolute;
  bottom: 2px;
  right: 2px;
  font-family: var(--font-mono);
  font-size: 0.52rem;
  font-weight: 700;
  color: var(--primary-accent);
  background: rgba(0, 0, 0, 0.75);
  padding: 1px 3px;
  border-radius: 2px;
}

.floating-card-meta {
  margin-top: 3px;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.floating-card-title {
  font-family: var(--font-heading);
  font-size: 0.68rem;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.floating-card-tag {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.floating-card-hint {
  font-family: var(--font-mono);
  font-size: 0.52rem;
  color: var(--primary-accent);
  margin-top: 1px;
  display: flex;
  align-items: center;
  gap: 2px;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   Large Grand Portrait Container & Chamber
   -------------------------------------------------------------------------- */
.grand-portrait-container {
  position: relative;
  width: 100%;
  max-width: 360px;
  height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  perspective: 1000px;
}

.halo-effect.grand-halo {
  position: absolute;
  width: 320px;
  height: 380px;
  border-radius: 24px;
  background: radial-gradient(ellipse at center, var(--accent-glow) 0%, transparent 72%);
  pointer-events: none;
  animation: grandHaloPulse 4s infinite ease-in-out;
}

@keyframes grandHaloPulse {
  0%, 100% {
    opacity: 0.65;
    transform: scale(0.98);
  }
  50% {
    opacity: 0.95;
    transform: scale(1.05);
  }
}

/* Quantum Warp Flare FX */
.quantum-warp-flare {
  position: absolute;
  width: 320px;
  height: 380px;
  border-radius: 20px;
  pointer-events: none;
  z-index: 8;
  background: radial-gradient(circle, #ffffff 0%, var(--primary-accent) 45%, transparent 75%);
  opacity: 0;
}

.quantum-warp-flare.active {
  animation: quantumWarpFlash 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Grand Portrait Wrapper (Full-scale animated portrait) */
.persona-avatar-wrapper.grand-portrait-wrapper {
  width: 285px;
  height: 355px;
  border-radius: 18px;
  overflow: hidden;
  border: 2px solid var(--primary-accent);
  box-shadow: 0 0 35px var(--accent-glow), 0 16px 40px rgba(0, 0, 0, 0.85);
  background: #050814;
  position: relative;
  transition: border-color 0.4s ease, box-shadow 0.4s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  animation: grandPortraitBreathe 6s ease-in-out infinite alternate;
  transform-style: preserve-3d;
  cursor: pointer;
}

.persona-avatar-wrapper.grand-portrait-wrapper:hover {
  transform: translateY(-4px) scale(1.02);
  border-color: #ffffff;
  box-shadow: 0 0 45px var(--primary-accent), 0 20px 48px rgba(0, 0, 0, 0.9);
}

.avatar-photo-img.grand-portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  filter: brightness(1.06) contrast(1.12) saturate(1.06);
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
}

.persona-avatar-wrapper.grand-portrait-wrapper:hover .avatar-photo-img {
  transform: scale(1.04);
}

/* Grand Portrait Breathing Idle Motion */
@keyframes grandPortraitBreathe {
  0% {
    transform: translateY(0px) scale(1);
    box-shadow: 0 0 30px var(--accent-glow), 0 14px 36px rgba(0, 0, 0, 0.8);
  }
  50% {
    transform: translateY(-8px) scale(1.015);
    box-shadow: 0 0 50px var(--accent-glow), 0 22px 48px rgba(0, 0, 0, 0.85);
  }
  100% {
    transform: translateY(0px) scale(1);
    box-shadow: 0 0 30px var(--accent-glow), 0 14px 36px rgba(0, 0, 0, 0.8);
  }
}

/* Hologram Atmosphere Layers */
.holo-scan-sweep {
  position: absolute;
  left: 0;
  right: 0;
  height: 25%;
  background: linear-gradient(to bottom, transparent, rgba(0, 240, 255, 0.25), transparent);
  animation: holoScanSweepGrand 3.2s linear infinite;
  pointer-events: none;
  z-index: 3;
}

@keyframes holoScanSweepGrand {
  0% {
    top: -25%;
    opacity: 0;
  }
  15% {
    opacity: 0.9;
  }
  85% {
    opacity: 0.9;
  }
  100% {
    top: 105%;
    opacity: 0;
  }
}

.holo-cyber-grid {
  position: absolute;
  inset: 0;
  background-size: 14px 14px;
  background-image: 
    linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  pointer-events: none;
  z-index: 2;
}

.holo-edge-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, transparent 55%, rgba(4, 7, 16, 0.85) 100%),
              linear-gradient(to bottom, transparent 75%, rgba(4, 7, 16, 0.95) 100%);
  pointer-events: none;
  z-index: 3;
}

/* Hologram Tech HUD Brackets */
.holo-hud-brackets {
  position: absolute;
  inset: 7px;
  pointer-events: none;
  z-index: 4;
}

.hud-corner {
  position: absolute;
  width: 14px;
  height: 14px;
  border-color: var(--primary-accent);
  opacity: 0.85;
}

.hud-corner.tl {
  top: 0;
  left: 0;
  border-top: 2px solid;
  border-left: 2px solid;
}

.hud-corner.tr {
  top: 0;
  right: 0;
  border-top: 2px solid;
  border-right: 2px solid;
}

.hud-corner.bl {
  bottom: 0;
  left: 0;
  border-bottom: 2px solid;
  border-left: 2px solid;
}

.hud-corner.br {
  bottom: 0;
  right: 0;
  border-bottom: 2px solid;
  border-right: 2px solid;
}

.holo-hud-tag {
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 5px;
  background: rgba(6, 10, 20, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 3px 8px;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 700;
  color: var(--primary-accent);
  letter-spacing: 0.6px;
  white-space: nowrap;
  backdrop-filter: blur(8px);
  z-index: 4;
}

.pulse-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--primary-accent);
  box-shadow: 0 0 6px var(--primary-accent);
  animation: pulse-ring 1.5s infinite;
}

/* --------------------------------------------------------------------------
   Audio Reactive Rings & Resonance Aura (Speech State)
   -------------------------------------------------------------------------- */
.audio-reactive-ring.grand-ring {
  position: absolute;
  width: 310px;
  height: 380px;
  border-radius: 24px;
  border: 2px dashed var(--primary-accent);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  z-index: 1;
}

.audio-resonance-aura {
  position: absolute;
  width: 335px;
  height: 400px;
  border-radius: 28px;
  border: 1px solid var(--primary-accent);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  z-index: 1;
}

/* TALKING ANIMATION ACTIVE (High-res Full Portrait) */
.persona-avatar-wrapper.grand-portrait-wrapper.talking {
  border-color: #ffffff;
  box-shadow: 0 0 50px var(--primary-accent), 0 0 90px var(--accent-glow), 0 20px 50px rgba(0, 0, 0, 0.95);
  animation: grandPortraitTalking 0.42s ease-in-out infinite alternate !important;
}

@keyframes grandPortraitTalking {
  0% {
    transform: translateY(-5px) scale(1.015);
    filter: brightness(1.08) contrast(1.15);
  }
  100% {
    transform: translateY(-11px) scale(1.032);
    filter: brightness(1.22) contrast(1.2) drop-shadow(0 0 16px var(--primary-accent));
  }
}

.persona-avatar-wrapper.talking ~ .audio-reactive-ring.grand-ring {
  opacity: 0.9;
  animation: audioRingPulse 1.2s ease-in-out infinite alternate;
}

.persona-avatar-wrapper.talking ~ .audio-resonance-aura {
  opacity: 0.75;
  animation: auraRippleGrand 1.6s ease-out infinite;
}

@keyframes auraRippleGrand {
  0% {
    transform: scale(0.96);
    opacity: 0.8;
  }
  100% {
    transform: scale(1.12);
    opacity: 0;
  }
}

/* Stop Voice Pill Button */
.stop-voice-pill {
  position: absolute;
  bottom: 8px;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  background: #ef4444;
  color: #ffffff;
  border: none;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.35rem 0.85rem;
  border-radius: 16px;
  cursor: pointer;
  box-shadow: 0 0 14px rgba(239, 68, 68, 0.7);
  animation: slideUpFade 0.2s ease-out;
}

.stop-voice-pill:hover {
  background: #dc2626;
  transform: translateY(-1px);
}

/* Top Projector Array */
.stage-projector-bar.top-projector {
  position: absolute;
  top: 48px;
  display: flex;
  align-items: center;
  gap: 14px;
  z-index: 3;
}

.emitter-node {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--text-dim);
  box-shadow: 0 0 4px var(--text-dim);
}

.emitter-node.main {
  width: 14px;
  height: 14px;
  background: var(--primary-accent);
  box-shadow: 0 0 12px var(--primary-accent);
}

.projector-glow-cone {
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  width: 200px;
  height: 110px;
  background: linear-gradient(180deg, var(--accent-glow) 0%, transparent 100%);
  clip-path: polygon(45% 0%, 55% 0%, 100% 100%, 0% 100%);
  pointer-events: none;
  opacity: 0.45;
}

/* Grand Hologram Pedestal Emitter */
.emitter-base.grand-pedestal {
  position: absolute;
  bottom: 4px;
  width: 280px;
  height: 38px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.pedestal-disc {
  width: 240px;
  height: 14px;
  border-radius: 50%;
  background: linear-gradient(90deg, #101935, #1f2f5c, #101935);
  border: 1px solid var(--primary-accent);
  box-shadow: 0 0 20px var(--accent-glow);
}

.pedestal-rings {
  position: absolute;
  bottom: 5px;
  width: 260px;
  height: 22px;
  border-radius: 50%;
  border: 1px dashed var(--primary-accent);
  opacity: 0.55;
  animation: audioRingRotate 18s linear infinite;
}

.pedestal-glow {
  position: absolute;
  bottom: -4px;
  width: 280px;
  height: 26px;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, var(--primary-accent) 0%, transparent 75%);
  filter: blur(8px);
  opacity: 0.75;
}

/* Persona Dossier */
.persona-dossier {
  margin-top: 0.6rem;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  flex-shrink: 0;
}

.dossier-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.persona-name {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.4px;
}

.grounded-tag {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--primary-accent);
  background: var(--accent-glow-subtle);
  border: 1px solid var(--accent-glow);
  padding: 0.12rem 0.4rem;
  border-radius: 10px;
  font-weight: 700;
}

.persona-title {
  font-size: 0.8rem;
  color: var(--primary-accent);
  font-weight: 500;
}

.persona-quote-box {
  background: rgba(0, 0, 0, 0.35);
  border-left: 2.5px solid var(--primary-accent);
  padding: 0.55rem 0.75rem;
  border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
  font-style: italic;
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.35;
  position: relative;
}

.quote-sign {
  color: var(--primary-accent);
  font-size: 1.1rem;
  font-weight: bold;
  margin-right: 0.2rem;
}

.dossier-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.4rem;
  margin-top: 0.2rem;
}

.stat-card {
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.06);
  padding: 0.4rem;
  border-radius: var(--border-radius-sm);
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.stat-label {
  font-family: var(--font-mono);
  font-size: 0.56rem;
  color: var(--text-dim);
  letter-spacing: 0.6px;
}

.stat-val {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 600;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat-val.highlight {
  color: var(--primary-accent);
}

/* Timeline Milestones Section */
.timeline-section {
  margin-top: 0.6rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  flex-shrink: 0;
}

.section-micro-label {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--text-dim);
  letter-spacing: 0.8px;
}

.milestones-track {
  display: flex;
  gap: 0.4rem;
  overflow-x: auto;
  padding-bottom: 2px;
  scrollbar-width: thin;
}

.milestone-chip {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--border-radius-sm);
  padding: 0.3rem 0.55rem;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  cursor: pointer;
  transition: all var(--transition-fast);
  max-width: 200px;
}

.milestone-chip:hover {
  background: var(--accent-glow-subtle);
  border-color: var(--primary-accent);
  transform: translateY(-1px);
}

.milestone-year {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  color: var(--primary-accent);
  background: rgba(0, 0, 0, 0.4);
  padding: 1px 3px;
  border-radius: 2px;
}

.milestone-text {
  font-size: 0.68rem;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Waveform Visualizer */
.audio-waveform {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 32px;
  margin-top: auto;
  padding-top: 0.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  flex-shrink: 0;
}

.wave-col {
  width: 3px;
  height: 5px;
  background-color: var(--primary-accent);
  border-radius: 2px;
  transition: height 0.12s ease;
}

.audio-waveform.active .wave-col {
  animation: equalizer 1s ease-in-out infinite alternate;
}

.audio-waveform.active .wave-col:nth-child(1) { animation-delay: 0.05s; }
.audio-waveform.active .wave-col:nth-child(2) { animation-delay: 0.2s; }
.audio-waveform.active .wave-col:nth-child(3) { animation-delay: 0.35s; }
.audio-waveform.active .wave-col:nth-child(4) { animation-delay: 0.1s; }
.audio-waveform.active .wave-col:nth-child(5) { animation-delay: 0.4s; }
.audio-waveform.active .wave-col:nth-child(6) { animation-delay: 0.25s; }
.audio-waveform.active .wave-col:nth-child(7) { animation-delay: 0.45s; }
.audio-waveform.active .wave-col:nth-child(8) { animation-delay: 0.15s; }
.audio-waveform.active .wave-col:nth-child(9) { animation-delay: 0.3s; }
.audio-waveform.active .wave-col:nth-child(10) { animation-delay: 0.5s; }
.audio-waveform.active .wave-col:nth-child(11) { animation-delay: 0.2s; }
.audio-waveform.active .wave-col:nth-child(12) { animation-delay: 0.35s; }

/* ==========================================================================
   Right: Chat Console Stage
   ========================================================================== */
.chat-console-stage {
  height: 100%;
  min-height: 0;
}

.console-card {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-surface-1);
  border: 1px solid var(--bg-surface-border);
  border-radius: var(--border-radius-lg);
  backdrop-filter: blur(20px);
  box-shadow: var(--shadow-elevated);
  overflow: hidden;
}

.console-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.7rem 1.25rem;
  background: rgba(0, 0, 0, 0.3);
  border-bottom: 1px solid var(--bg-surface-border);
  flex-shrink: 0;
}

.channel-info {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-muted);
}

.channel-indicator {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--primary-accent);
}

.clear-action-btn {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 0.2rem 0.6rem;
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.clear-action-btn:hover {
  color: #fff;
  border-color: rgba(255, 255, 255, 0.3);
}

/* Category Tabs Bar */
.category-tabs-bar {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1.25rem;
  background: rgba(0, 0, 0, 0.2);
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  overflow-x: auto;
  scrollbar-width: none;
  flex-shrink: 0;
}

.category-tabs-bar::-webkit-scrollbar {
  display: none;
}

.category-pill {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text-muted);
  font-family: var(--font-main);
  font-size: 0.74rem;
  font-weight: 600;
  padding: 0.22rem 0.7rem;
  border-radius: 14px;
  cursor: pointer;
  white-space: nowrap;
  transition: all var(--transition-fast);
}

.category-pill:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
}

.category-pill.active {
  background: var(--primary-accent);
  color: #060913;
  font-weight: 700;
  box-shadow: 0 0 10px var(--accent-glow);
}

/* Messages Flow */
.messages-flow {
  flex: 1;
  padding: 1.15rem 1.25rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  scroll-behavior: smooth;
  min-height: 0;
}

/* Slim Custom Scrollbar */
.messages-flow::-webkit-scrollbar,
.stage-card::-webkit-scrollbar,
.drawer-body::-webkit-scrollbar,
.placards-grid::-webkit-scrollbar {
  width: 5px;
}

.messages-flow::-webkit-scrollbar-thumb,
.stage-card::-webkit-scrollbar-thumb,
.drawer-body::-webkit-scrollbar-thumb,
.placards-grid::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3px;
}

.messages-flow::-webkit-scrollbar-thumb:hover {
  background: var(--primary-accent);
}

/* Message Rows */
.msg-row {
  display: flex;
  gap: 0.75rem;
  max-width: 86%;
  animation: slideUpFade 0.25s ease-out;
}

.msg-row.user {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.msg-row.persona {
  align-self: flex-start;
}

.msg-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #111a33;
  border: 1.5px solid var(--primary-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 8px var(--accent-glow);
  overflow: hidden;
}

.msg-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.msg-row.user .msg-avatar {
  background: #1e293b;
  border-color: #64748b;
  box-shadow: none;
  color: #94a3b8;
}

.msg-bubble-wrap {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.msg-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--text-dim);
}

.msg-row.user .msg-meta {
  justify-content: flex-end;
}

.msg-bubble {
  padding: 0.8rem 1.05rem;
  border-radius: var(--border-radius-md);
  font-size: 0.9rem;
  line-height: 1.55;
  position: relative;
  word-wrap: break-word;
}

.msg-row.user .msg-bubble {
  background: rgba(30, 41, 59, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #f8fafc;
  border-top-right-radius: 2px;
}

.msg-row.persona .msg-bubble {
  background: var(--bg-surface-2);
  border: 1px solid var(--bg-surface-border);
  box-shadow: 0 3px 16px rgba(0, 0, 0, 0.3);
  color: #f1f5f9;
  border-top-left-radius: 2px;
}

/* Streaming Typewriter Cursor */
.streaming-cursor {
  display: inline-block;
  width: 6px;
  height: 13px;
  background-color: var(--primary-accent);
  margin-left: 2px;
  vertical-align: middle;
  animation: cursorBlink 0.65s infinite;
}

.msg-tools {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin-top: 0.3rem;
}

.bubble-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.66rem;
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  transition: all var(--transition-fast);
}

.bubble-btn:hover {
  background: var(--accent-glow-subtle);
  border-color: var(--primary-accent);
  color: var(--primary-accent);
}

/* Typing Indicator Dots */
.typing-dots {
  display: inline-flex;
  gap: 4px;
  padding: 3px 2px;
}

.typing-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--primary-accent);
  animation: typing-bounce 1.3s infinite ease-in-out;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

/* Prompts Bar */
.prompts-bar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.55rem 1.25rem;
  background: rgba(0, 0, 0, 0.25);
  border-top: 1px solid rgba(255, 255, 255, 0.04);
  overflow-x: auto;
  scrollbar-width: none;
  flex-shrink: 0;
}

.prompts-bar::-webkit-scrollbar {
  display: none;
}

.prompts-tag {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--text-dim);
  letter-spacing: 0.8px;
  flex-shrink: 0;
}

.prompt-chip {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.09);
  color: var(--text-muted);
  font-size: 0.76rem;
  padding: 0.3rem 0.75rem;
  border-radius: 16px;
  cursor: pointer;
  white-space: nowrap;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.prompt-chip:hover {
  background: var(--accent-glow-subtle);
  border-color: var(--primary-accent);
  color: #ffffff;
  transform: translateY(-1px);
}

/* Input Dock */
.input-dock {
  padding: 0.85rem 1.25rem;
  background: rgba(0, 0, 0, 0.35);
  border-top: 1px solid var(--bg-surface-border);
  flex-shrink: 0;
}

.chat-form {
  width: 100%;
}

.input-shell {
  display: flex;
  align-items: center;
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--bg-surface-border);
  border-radius: var(--border-radius-md);
  padding: 0.35rem 0.5rem 0.35rem 0.9rem;
  transition: all var(--transition-fast);
}

.input-shell:focus-within {
  border-color: var(--primary-accent);
  box-shadow: 0 0 14px var(--accent-glow);
}

textarea#user-input {
  flex: 1;
  background: transparent;
  border: none;
  color: #fff;
  font-family: var(--font-main);
  font-size: 0.9rem;
  resize: none;
  outline: none;
  max-height: 100px;
  line-height: 1.4;
  padding: 0.3rem 0;
}

textarea#user-input::placeholder {
  color: var(--text-dim);
}

.dock-actions {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.dock-btn {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.09);
  color: var(--text-main);
  width: 34px;
  height: 34px;
  border-radius: var(--border-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.dock-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: var(--primary-accent);
}

.dock-btn.listening {
  background: #ef4444;
  border-color: #f87171;
  color: #fff;
  animation: pulse-ring 1.5s infinite;
}

.transmit-btn {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--primary-accent);
  color: #060913;
  border: none;
  font-family: var(--font-main);
  font-size: 0.85rem;
  font-weight: 700;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.transmit-btn:hover:not(:disabled) {
  box-shadow: 0 0 16px var(--primary-accent);
  transform: translateY(-1px);
}

.transmit-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.dock-footnote {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.5rem;
  font-size: 0.68rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
}

.rec-active-tag {
  color: #ef4444;
  font-weight: 600;
  animation: pulse-ring 1s infinite;
}

.hidden {
  display: none !important;
}

/* Toast Bubble */
.toast-bubble {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid var(--primary-accent);
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  padding: 0.5rem 1.15rem;
  border-radius: 20px;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.6);
  z-index: 10000;
  animation: slideUpFade 0.2s ease-out;
}

/* ==========================================================================
   Modals: Access Gate & QR Studio
   ========================================================================== */
.modal-scrim {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(4, 7, 14, 0.88);
  backdrop-filter: blur(12px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.25rem;
  animation: slideUpFade 0.2s ease-out;
}

.gate-card {
  width: 560px;
  max-width: 95vw;
  background: #0b0f1a;
  border: 1px solid var(--primary-accent);
  border-radius: var(--border-radius-lg);
  box-shadow: 0 0 40px var(--accent-glow-subtle);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.35rem;
  position: relative;
}

.gate-header {
  text-align: center;
}

.gate-icon-badge {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--accent-secondary), var(--primary-accent));
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 0 16px var(--accent-glow);
  margin-bottom: 0.65rem;
}

.gate-header h2 {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 0.35rem;
}

.gate-header p {
  font-size: 0.84rem;
  color: var(--text-muted);
  line-height: 1.45;
}

.gate-group {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.gate-group-label {
  font-family: var(--font-mono);
  font-size: 0.66rem;
  letter-spacing: 1.2px;
  color: var(--primary-accent);
  font-weight: 700;
}

.gate-cards-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.65rem;
}

.gate-choice-card {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--border-radius-md);
  padding: 0.75rem 0.4rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.45rem;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.gate-choice-card img {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  object-fit: cover;
  border: 1.5px solid rgba(255, 255, 255, 0.2);
}

.gate-choice-card:hover {
  background: var(--accent-glow-subtle);
  border-color: var(--primary-accent);
  transform: translateY(-2px);
}

.gate-choice-card:hover img {
  border-color: var(--primary-accent);
  box-shadow: 0 0 10px var(--accent-glow);
}

.choice-text {
  text-align: center;
}

.choice-text strong {
  display: block;
  font-size: 0.8rem;
  color: #fff;
  line-height: 1.2;
}

.choice-text span {
  font-size: 0.66rem;
  color: var(--text-muted);
}

.gate-or-separator {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.gate-or-separator::before {
  content: "";
  position: absolute;
  width: 100%;
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
}

.gate-or-separator span {
  position: relative;
  background: #0b0f1a;
  padding: 0 0.8rem;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--text-dim);
}

.pin-entry-row {
  display: flex;
  gap: 0.65rem;
}

.pin-entry-row input {
  flex: 1;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--border-radius-sm);
  padding: 0.65rem 0.85rem;
  color: #fff;
  font-family: var(--font-mono);
  font-size: 0.95rem;
  letter-spacing: 2px;
  outline: none;
}

.pin-entry-row input:focus {
  border-color: var(--primary-accent);
  box-shadow: 0 0 10px var(--accent-glow);
}

.pin-err-label {
  font-size: 0.72rem;
  color: #f87171;
  font-family: var(--font-mono);
  min-height: 0.9rem;
}

/* QR Badges Studio Modal */
.studio-card {
  width: 1050px;
  max-width: 95vw;
  max-height: 90vh;
  background: #0a0e1c;
  border: 1px solid var(--bg-surface-border);
  border-radius: var(--border-radius-lg);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  padding: 1.5rem;
  overflow: hidden;
}

.studio-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1.15rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 0.75rem;
}

.studio-top h2 {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
}

.studio-top p {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-top: 0.15rem;
}

.studio-actions {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.print-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: var(--primary-accent);
  color: #060913;
  font-weight: 700;
  font-family: var(--font-main);
  font-size: 0.8rem;
  padding: 0.45rem 0.85rem;
  border-radius: var(--border-radius-sm);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.print-action-btn:hover {
  box-shadow: 0 0 14px var(--primary-accent);
}

.drawer-close-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 1.6rem;
  cursor: pointer;
  padding: 0 0.4rem;
  line-height: 1;
}

.drawer-close-btn:hover {
  color: #fff;
}

.studio-network-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--border-radius-md);
  padding: 0.6rem 0.95rem;
  margin-bottom: 1.15rem;
  gap: 1rem;
  flex-wrap: wrap;
}

.net-info-left {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.net-pill-label {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 700;
  color: var(--primary-accent);
  letter-spacing: 0.9px;
}

.net-toggle-group {
  display: flex;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 20px;
  padding: 2px;
  gap: 3px;
}

.net-mode-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-family: var(--font-main);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.28rem 0.75rem;
  border-radius: 16px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.net-mode-btn:hover {
  color: #fff;
}

.net-mode-btn.active {
  background: var(--primary-accent);
  color: #060913;
  font-weight: 700;
  box-shadow: 0 0 10px var(--accent-glow);
}

.net-active-domain {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--text-dim);
}

.net-active-domain code {
  color: #4ade80;
  background: rgba(74, 222, 128, 0.1);
  padding: 2px 7px;
  border-radius: 4px;
  border: 1px solid rgba(74, 222, 128, 0.25);
  font-weight: 600;
  max-width: 320px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.placards-grid {
  flex: 1;
  overflow-y: auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.15rem;
  padding-right: 0.4rem;
}

/* Individual Placard Card */
.exhibit-qr-card {
  background: #0f1528;
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--border-radius-md);
  padding: 1.15rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  transition: all var(--transition-fast);
}

.exhibit-qr-card:hover {
  border-color: var(--primary-accent);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.card-photo-wrap {
  width: 78px;
  height: 78px;
  border-radius: 50%;
  overflow: hidden;
  border: 2.5px solid var(--primary-accent);
  margin-bottom: 0.55rem;
}

.card-photo-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-persona-name {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 0.1rem;
}

.card-persona-title {
  font-size: 0.72rem;
  color: var(--primary-accent);
  font-weight: 600;
  margin-bottom: 0.65rem;
}

.card-qr-img-wrap {
  width: 175px;
  height: 175px;
  background: #ffffff;
  padding: 6px;
  border-radius: 8px;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.3);
  margin-bottom: 0.55rem;
}

.card-qr-img-wrap img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-scan-label {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--text-dim);
  letter-spacing: 0.8px;
  margin-bottom: 0.45rem;
}

.card-qr-target-url {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--primary-accent);
  background: rgba(0, 240, 255, 0.08);
  border: 1px solid rgba(0, 240, 255, 0.18);
  padding: 3px 6px;
  border-radius: 4px;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 0.65rem;
  text-align: center;
}

.card-actions-row {
  display: flex;
  gap: 0.45rem;
  width: 100%;
}

.card-download-btn, .card-copy-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #fff;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  padding: 0.4rem 0.5rem;
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  text-decoration: none;
  transition: all var(--transition-fast);
}

.card-download-btn:hover, .card-copy-btn:hover {
  background: var(--accent-glow-subtle);
  border-color: var(--primary-accent);
  color: var(--primary-accent);
}

/* ==========================================================================
   Historical Artifacts & Works Codex Modal
   ========================================================================== */
.codex-card {
  width: 960px;
  max-width: 95vw;
  max-height: 88vh;
  background: #090e1c;
  border: 1px solid var(--primary-accent);
  border-radius: var(--border-radius-lg);
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.8), 0 0 30px var(--accent-glow-subtle);
  display: flex;
  flex-direction: column;
  padding: 1.5rem;
  overflow: hidden;
  position: relative;
}

.codex-grid {
  flex: 1;
  overflow-y: auto;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
  padding-right: 0.3rem;
  margin-top: 0.5rem;
}

.codex-item-card {
  background: rgba(18, 26, 48, 0.7);
  border: 1px solid var(--bg-surface-border);
  border-radius: var(--border-radius-md);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all var(--transition-fast);
  position: relative;
}

.codex-item-card:hover {
  border-color: var(--primary-accent);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 18px var(--accent-glow-subtle);
}

.codex-img-wrap {
  position: relative;
  width: 100%;
  height: 190px;
  background: #050811;
  overflow: hidden;
}

.codex-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.codex-item-card:hover .codex-img-wrap img {
  transform: scale(1.04);
}

.codex-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(9, 14, 28, 0.95) 0%, rgba(9, 14, 28, 0.2) 60%, transparent 100%);
  pointer-events: none;
}

.codex-badge-row {
  position: absolute;
  top: 10px;
  left: 10px;
  display: flex;
  gap: 6px;
  z-index: 2;
}

.codex-year-tag {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  background: rgba(0, 0, 0, 0.75);
  color: var(--primary-accent);
  border: 1px solid var(--primary-accent);
  padding: 2px 7px;
  border-radius: 4px;
  backdrop-filter: blur(4px);
}

.codex-category-tag {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  padding: 2px 7px;
  border-radius: 4px;
  backdrop-filter: blur(4px);
}

.codex-content {
  padding: 1rem 1.15rem;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 0.5rem;
}

.codex-content h3 {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.codex-content p {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.45;
  flex: 1;
}

.codex-ask-btn {
  margin-top: 0.5rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--accent-glow-subtle);
  border: 1px solid var(--primary-accent);
  color: var(--primary-accent);
  font-family: var(--font-main);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 0.5rem 0.9rem;
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
  text-align: center;
}

.codex-ask-btn:hover {
  background: var(--primary-accent);
  color: #060913;
  box-shadow: 0 0 16px var(--accent-glow);
}

/* ==========================================================================
   Print Stylesheet (@media print)
   ========================================================================== */
@media print {
  body {
    background: #ffffff !important;
    color: #000000 !important;
  }
  .app-header, .main-layout, .modal-scrim:not(#qr-studio-modal), .ambient-glow-bg, .subtle-grid-bg, .studio-actions {
    display: none !important;
  }
  #qr-studio-modal {
    position: static !important;
    background: transparent !important;
    padding: 0 !important;
    display: block !important;
  }
  .studio-card {
    width: 100% !important;
    max-width: 100% !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    background: #ffffff !important;
    color: #000000 !important;
  }
  .placards-grid {
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 16px !important;
  }
  .exhibit-qr-card {
    background: #ffffff !important;
    border: 2px solid #000000 !important;
    box-shadow: none !important;
    page-break-inside: avoid;
    color: #000000 !important;
  }
  .card-persona-name { color: #000000 !important; }
  .card-persona-title { color: #333333 !important; }
  .card-scan-label { color: #555555 !important; }
  .card-download-btn { display: none !important; }
}

/* Grounded Context Drawer */
.drawer-scrim {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 998;
}

.context-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: 460px;
  max-width: 90vw;
  height: 100vh;
  background: #090e1c;
  border-left: 1px solid var(--bg-surface-border);
  box-shadow: -10px 0 40px rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  flex-direction: column;
  animation: slideLeft 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.drawer-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.15rem 1.35rem;
  border-bottom: 1px solid var(--bg-surface-border);
  background: rgba(255, 255, 255, 0.02);
}

.drawer-title-wrap h3 {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
}

.drawer-title-wrap p {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--text-muted);
}

.drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 1.35rem;
  display: flex;
  flex-direction: column;
  gap: 1.15rem;
}

.empty-state-notice {
  text-align: center;
  color: var(--text-muted);
  padding: 3rem 1.25rem;
  font-size: 0.88rem;
  line-height: 1.5;
}

.chunk-card {
  background: rgba(18, 26, 50, 0.8);
  border: 1px solid var(--bg-surface-border);
  border-radius: var(--border-radius-md);
  padding: 1rem;
  position: relative;
}

.chunk-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.65rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
}

.chunk-badge {
  color: var(--primary-accent);
  background: var(--accent-glow-subtle);
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  font-weight: 700;
}

.chunk-chars {
  color: var(--text-dim);
}

.chunk-body {
  font-size: 0.84rem;
  line-height: 1.5;
  color: #cbd5e1;
  font-style: italic;
  white-space: pre-wrap;
}

/* ==========================================================================
   Animations
   ========================================================================== */
@keyframes avatarIdleBreath {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-3px) scale(1.01); }
}

@keyframes headTalkingPulse {
  0% { transform: scale(1) translateY(0) rotate(0deg); }
  33% { transform: scale(1.015) translateY(-2px) rotate(0.4deg); }
  66% { transform: scale(0.995) translateY(1px) rotate(-0.3deg); }
  100% { transform: scale(1.01) translateY(-1px) rotate(0.2deg); }
}

@keyframes audioRingRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes audioRingPulse {
  0% { transform: scale(0.96); opacity: 0.5; }
  100% { transform: scale(1.06); opacity: 0.95; }
}

@keyframes holoScanSweep {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100%); }
}

@keyframes cursorBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

@keyframes pulse-ring {
  0% { transform: scale(0.98); opacity: 0.75; }
  100% { transform: scale(1.02); opacity: 1; }
}

@keyframes spin-slow {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes spin-rev {
  from { transform: translate(-50%, -50%) rotate(360deg); }
  to { transform: translate(-50%, -50%) rotate(0deg); }
}

@keyframes equalizer {
  0% { height: 4px; }
  100% { height: 26px; }
}

@keyframes slideUpFade {
  from { opacity: 0; transform: translateY(10px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes slideLeft {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

@keyframes typing-bounce {
  0%, 80%, 100% { transform: scale(0); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

@keyframes floatDriftLeft {
  0% { transform: translate(0, 0) rotate(-1deg); }
  50% { transform: translate(4px, -7px) rotate(1.2deg); }
  100% { transform: translate(-3px, 4px) rotate(-1.5deg); }
}

@keyframes floatDriftRight {
  0% { transform: translate(0, 0) rotate(1deg); }
  50% { transform: translate(-4px, -9px) rotate(-1.2deg); }
  100% { transform: translate(3px, 5px) rotate(1.5deg); }
}

@keyframes quantumWarpFlash {
  0% { transform: scale(0.2); opacity: 0; }
  35% { transform: scale(1.6); opacity: 0.95; filter: blur(2px); }
  100% { transform: scale(2.4); opacity: 0; filter: blur(8px); }
}

/* ==========================================================================
   Responsive Breakpoints & PC Screen Fit
   ========================================================================== */
@media (max-height: 820px) {
  .emitter-view {
    min-height: 160px;
    padding: 0.5rem 0.5rem 0.2rem;
  }
  .avatar-podium {
    width: 125px;
    height: 125px;
  }
  .persona-avatar-wrapper {
    width: 112px;
    height: 112px;
  }
  .persona-dossier {
    margin-top: 0.4rem;
    gap: 0.35rem;
  }
  .persona-name {
    font-size: 1.15rem;
  }
  .persona-quote-box {
    padding: 0.4rem 0.6rem;
    font-size: 0.75rem;
  }
  .stat-card {
    padding: 0.3rem;
  }
}

@media (max-width: 1100px) {
  .main-layout {
    grid-template-columns: 340px 1fr;
    padding: 0.85rem 1rem;
    gap: 1rem;
  }
}

@media (max-width: 900px) {
  body {
    overflow-y: auto;
  }
  .main-layout {
    grid-template-columns: 1fr;
    height: auto;
    overflow-y: visible;
  }
  .hologram-stage {
    height: 480px;
  }
  .chat-console-stage {
    height: 600px;
  }
  .placards-grid {
    grid-template-columns: 1fr;
  }
  .codex-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .app-header {
    flex-direction: column;
    height: auto;
    padding: 0.75rem;
    gap: 0.6rem;
  }
  .main-layout {
    padding: 0.75rem;
  }
  .dossier-stats-grid {
    grid-template-columns: 1fr;
  }
  .gate-cards-row {
    grid-template-columns: 1fr;
  }
}
